<?xml version="1.0" encoding="utf-8"?>
<!-- Allows cleartext (http) for local/dev and trusts system CAs for https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">api.orarepot.com</domain>
        <domain includeSubdomains="true">orarepot.com</domain>
        <domain includeSubdomains="true">orarepot.tikngroup.com</domain>
    </domain-config>
</network-security-config>
